<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jxcia.blog.service.mapper.user.UserMapper">

    <select id="findByUser" resultType="com.jxcia.blog.pojo.entity.User">
        select *
        from user
        <where>
            <if test="nickname != null and nickname != ''">nickname like concat('%', #{nickname}, '%')</if>
            <if test="email != null and email != ''">email = #{email}</if>
        </where>
    </select>
</mapper>