<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jxcia.blog.mapper.admin.PermissionMapper">

    <select id="getByRoleIdList" resultType="com.jxcia.blog.pojo.entity.Permission">
        select distinct url from permission
        where id in (
            select permission_id from role_permission_relation where role_id in (
                <foreach collection="roleIdList" item="rId" open="(" close=")" separator=",">
                    #{rId}
                </foreach>
                )
            )
    </select>
</mapper>