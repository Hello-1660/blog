<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jxcia.blog.mapper.admin.MenuMapper">

    <resultMap id="MenuResultMap" type="com.jxcia.blog.pojo.entity.Menu" autoMapping="true">
        <result column="web_name" property="webNme"/>
    </resultMap>

    <update id="update">
        update menu
        <set>
            <if test="pId != null">p_id = #{pId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="level != null">level = #{level},</if>
            <if test="webNme != null and webNme != ''">web_name = #{webNme},</if>
            <if test="icon != null and icon != ''">icon = #{icon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        where id = #{id}
    </update>
</mapper>
