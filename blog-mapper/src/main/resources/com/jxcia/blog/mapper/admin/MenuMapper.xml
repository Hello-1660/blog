<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jxcia.blog.mapper.admin.MenuMapper">

    <resultMap id="MenuResultMap" type="com.jxcia.blog.pojo.entity.Menu" autoMapping="true">
        <result column="web_name" property="webNme"/>
    </resultMap>

    <select id="getByRoleIdList" resultMap="MenuResultMap">
        select * from menu
        <if test="roleIdList != null and roleIdList.size() > 0">
            where id in (
                select menu_id from role_menu_relation where role_id in
                <foreach collection="roleIdList" item="rId" open="(" close=")" separator=",">
                    #{rId}
                </foreach>
            )
        </if>
        <if test="roleIdList == null or roleIdList.size() == 0">
            where 1 = 0
        </if>
        order by level, sort
    </select>

    <update id="update">
        update menu
        <set>
            <if test="pId != null">p_id = #{pId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="level != null">level = #{level},</if>
            <if test="webNme != null and webNme != ''">web_name = #{webNme},</if>
            <if test="icon != null and icon != ''">icon = #{icon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        where id = #{id}
    </update>
</mapper>
